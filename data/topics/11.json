يبة]","الانسان"],["اليأس و القنوط"]],"10":[["بعض طبيعة الانسان في الحياة","الفخر"],["بعض فطرة الانسان","الفرح"],["التفاخر"],["صفات أخرى","صفات الكافرين"]],"11":[["الأجر الكبير [أجر الصابرين]","الأجر"],["جزاؤهم عند الحساب","جزاء المؤمنين"],["الصبر"],["مثوبة الصابرين","الصبر"],["الموعودو بالمغفرة [الصابرون والذين يخشون ربهم بالغيب]","الغفران والاستغفار"]],"12":[["تثبيت االرسول","محمد رسول اللّه"],["الضَّيق النفسي"],["الكنز"],["لا يكون الملك رسولاً إلى الناس","الملائكة"],["مبلِّغ الناس وليس عليهم بمسيطر","خاتم الأنبياء محمد صلى الله عليه وسلم"],["مقر الضيق والحرج","الصدر"],["الوحي"],["اليتيم الفقير","خاتم الأنبياء محمد صلى الله عليه وسلم"]],"13":[["انكار القوم لدعوة الرسول","محمد رسول اللّه"],["تحدّي المشركين أن يأتوا بسورة","السًّورة"],["تحدّي أهل البلاغة أن يأتوا بمثله","القرآن"],["قالوا [ساحر وشاعر وكاهن ومُفْتر ويأتي بأساطير الأولين]","خاتم الأنبياء محمد صلى الله عليه وسلم"],["مقولة الكفار عن القرآن","الفرية والافتراء"],["مقالات المشركين عن القرآن [قالوا إن الرسول افتراه]","القرآن"],["مقولاتهم عن القرآن","الكفر"]],"14":[["التحذير من عدم الاستجابة","الاجابة والاستجابة"],["تنزيله من عند الله بالحق على الرسول [صلى الله عليه وسلم]","القرآن"],["الواحد الأحد","الله جلّ جلاله"]],"15":[["البخْس"],["باطل أن تكون الدنيا هي الغاية","الباطل"],["تزيينها في عين الإنسان اختباراً له","الأرض"],["الحياة الدنيا"],["الله لا يبخس الناس أعمالهم","البخْس"],["مصير المكذبين بآيات الله","النار"]],"16":[["جزاؤهم عند الموت و الحساب","جزاء الكافرين"],["خلودهم في النار","جزاء الكافرين"],["الخسران لأصحاب الباطل","الباطل"]],"17":[["أكثرهم لا يؤمنون","الناس"],["إنزالها من عند الله على موسى","الكتاب [التوراة والإنجيل]"],["نوعيات أهل الجحيم [الكفرة والمشركون]","الجحيم"]],"18":[["أظلم الناس [من افترى على الله الكذب أو كذب آياته]","الظلم"],["جزاء الظالمين","الظلم"],["الصد عن سبيل اللّه","الظلم"],["في علاقتهم مع اللّه","صفات الكافرين"],["لهم في الآخرة العذاب الشديد","الظلم"],["نماذج من البغي والعدوان","العدوان"]],"19":[["تهديدهم","صفات الكافرين"],["عقابهم","الصد عن سبيل اللّه"]],"20":[["الصَّمم"],["يضا