ان"]],"39":[["أخبار عن النار [للنار دعاة إليها]","النار"],["إغراق فرعون و جنوده","موسى و هارون"],["الجنود"],["سنن الله في خلقه [أن يخزي أعداءه ويهلك المفسدين في الأرض]","الله جلّ جلاله"],["سوء مصيره مع الفرعون","هامان"],["محتومٌ هلاك الفرعون [كل فرعون]","فرعون"]],"40":[["جزاء الظالمين","الظلم"],["ضرورة النظر في عواقب الكفرة والمفسدين في الأرض","الرؤية"],["ضرورة الاعتبار بمصائر الظلمة","الظلم"],["النهاية [إغراق الفرعون وجنده]","فرعون"],["نوعيات أهل الجحيم [مدعو الألوهية]","الجحيم"]],"41":[["يوم القيامة","أسماء اليوم الآخر"],["يوم الجزاء","القارعة"]],"43":[["إنزال التوراة على موسى و عبادة","موسى و هارون"],["إيتاؤه الكتاب والآيات والسلطان المبين","موسى عليه السلام"],["إنزالها من عند الله على موسى","الكتاب [التوراة والإنجيل]"],["البصيرة نور القلب","البصيرة"],["الله [منزل الكتاب]","الله جلّ جلاله"]],"44":[["تثبيت االرسول","محمد رسول اللّه"],["لا رادّ لقضاء الله","القضاء"],["الوحي"]],"45":[["الآية [الجملة من القرآن]"],["الطول"]],"46":[["بدء الدعوة مع قومه","محمد رسول اللّه"],["البشير النذير","خاتم الأنبياء محمد صلى الله عليه وسلم"],["الطًَور"],["لماذا بعث الله الرسل","البعثة"],["لماذا التذكّر","التذكير والذكرى"]],"47":[["الآية [الجملة من القرآن]"],["أهي ابتلاء أم عقوبة","المصيبة"],["انكار القوم لدعوة الرسول","محمد رسول اللّه"],["الرسالات [لإسقاط حجة البشر وللشهادة عليهم]","الرسالة والرسل"]],"48":[["إرساله بالهدى والحق رحمة للعالمين","خاتم الأنبياء محمد صلى الله عليه وسلم"],["اتباع الهوى يضل عن اتباع الحق","الهوى"],["سمات الكفرة [هم محرومون من حب الله ومن هدايته]","الكفر"],["مقالات المشركين عن القرآن [قالوا إنه سحر ساحر]","القرآن"],["مقولاتهم عن الرسالات وإعناتهم المرسلين","الكفر"]],"50":[["تعرض الشيطان للأنبياء","الشَّيطان"],["ذم اتباعه","الهوى"],["ذمّ متّبعي أهوائهم وسوء منقلبهم","الاتباع"],["الضالون [الذين يتبعون أهواءهم ضالون]","الضلال والضالون"],["الظلمة محجوبون عن الهداية","الظلم"],["المحرومون من هداية الله [القوم الظالمون]","الهُدى [نقيض الضلال]"]],"51":[["لماذا التذكّر","التذكير والذكرى"]],"52":[["أثر تلاوة القرآن في المؤمنين","التلاوة"],["حقيقته أن تؤمن بالله وملا