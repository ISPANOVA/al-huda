<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_tile" android:importantForAccessibility="no" />
    
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="10dp">
        <ImageView android:id="@+id/tile_icon" android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/widget_ic_fajr" android:importantForAccessibility="no" />
        <TextView android:id="@+id/tile_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textSize="14sp" android:textColor="#FFB8B8B8" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/tile_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٥:٣٥" android:textSize="28sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/tile_in" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بعد ٣ س" android:textSize="12sp" android:textColor="#FFA3A3A3" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="4dp" />
    </LinearLayout>
</FrameLayout>
