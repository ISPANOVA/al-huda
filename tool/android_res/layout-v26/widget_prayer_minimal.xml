<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_card" android:importantForAccessibility="no" />
    
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/prev_dot" android:layout_width="7dp" android:layout_height="7dp"
                android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/prev_name" android:layout_width="0dp" android:layout_height="wrap_content" android:text="الشروق" android:textSize="20sp" android:textColor="#FFB8B8B8" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="3" android:layout_weight="1" android:layout_marginStart="14dp" />
            
            <TextView android:id="@+id/prev_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٥:٣٤" android:textSize="24sp" android:textColor="#FFB8B8B8" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold"  />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#2EFFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/next_dot" android:layout_width="7dp" android:layout_height="7dp"
                android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/next_name" android:layout_width="0dp" android:layout_height="wrap_content" android:text="الظهر" android:textSize="20sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="3" android:layout_weight="1" android:layout_marginStart="14dp" />
            <TextView android:id="@+id/next_in" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بعد ٣ س ٤٣ د" android:textSize="18sp" android:textColor="#FFD6D6D6" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginEnd="12dp" />
            <TextView android:id="@+id/next_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="١١:٣٤" android:textSize="24sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold"  />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
